# Copia este archivo a .env en la raiz y completa los valores antes de:
#   docker compose up -d --build
# No subas el .env al repositorio.

# MySQL solo es visible dentro de la red de Compose. No se publica el puerto 3306.
MYSQL_ROOT_PASSWORD=
DB_NAME=asistencias
DB_USER=asistencias
DB_PASSWORD=

# API del panel y del receptor. Minimo 16 caracteres; no uses el texto de ejemplo.
API_KEY=
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
CORS_ORIGIN=https://huellero.adsholistic.com

# Resolver ACME del Traefik que ya corre en el VPS (el de n8n es mytlschallenge).
TRAEFIK_CERTRESOLVER=mytlschallenge

# Reloj ZKTeco. Vacias, el puerto 8088 no filtra IP ni exige comm key.
ADMS_COMM_KEY=
ADMS_IP_ALLOWLIST=
ADMS_BODY_LIMIT=20mb

# Cierre de faltas dentro del contenedor, hora America/Lima.
CIERRE_AUTOMATICO=true
CIERRE_CRON="59 23 * * *"
DB_CONNECTION_LIMIT=10

# El reloj usa el 8088 publicado en el host. El panel entra por Traefik (443), no por el puerto 80.
ADMS_PORT=8088

# Vacio: el panel llama a /api en el mismo origen (Nginx reenvia al backend).
# Solo rellena si el navegador debe hablar con otra URL publica.
VITE_API_URL=
