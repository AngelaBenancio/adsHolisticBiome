# Desarrollo en el host. En Docker Compose las mismas claves salen del .env de la raiz
# y el compose fija DB_HOST=mysql. Este archivo no entra en la imagen.
PORT=8088
TRUST_PROXY=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=asistencias
DB_PASSWORD=clave-mysql-larga
DB_NAME=asistencias
DB_CONNECTION_LIMIT=10
API_KEY=reemplaza-por-una-clave-de-al-menos-16
# Primer usuario del panel. Solo se crea si asist_usuarios está vacía. Mínimo 8 caracteres.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
CORS_ORIGIN=*
# Clave que el reloj envia en ?comkey= o ?token=. Vacia, el puerto no exige clave.
ADMS_COMM_KEY=
# IPs del reloj, separadas por coma. Vacia, no hay lista blanca.
ADMS_IP_ALLOWLIST=
ADMS_BODY_LIMIT=20mb
# Cierre de faltas dentro del proceso, hora America/Lima. 59 23 * * * es las 23:59.
CIERRE_AUTOMATICO=true
CIERRE_CRON=59 23 * * *
# Los destinos en tiempo real (Hecom Club u otro) se configuran en el panel, no aqui.
