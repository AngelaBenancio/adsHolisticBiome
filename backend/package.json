{
  "name": "asistencias-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Receptor ADMS ZKTeco, calculo de asistencia y API del panel.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:init": "node dist/scripts/init-db.js",
    "db:import": "tsx src/scripts/importar-zkbio.ts",
    "cierre": "tsx src/scripts/cerrar-dia.ts",
    "check": "tsx src/dev/autoverificacion.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mysql2": "^3.14.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
